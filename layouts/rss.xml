{{- $page := . -}}
{{- $site := .Site -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\" ?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>
      {{- if eq $page.Title $site.Title -}}
        {{ $site.Title }}
      {{- else -}}
        {{ $page.Title }} – {{ $site.Title }}
      {{- end -}}
    </title>

    <link>{{ $page.Permalink }}</link>

    <description>
      {{- if eq $page.Title $site.Title -}}
        Recent content on {{ $site.Title }}
      {{- else -}}
        Recent content in {{ $page.Title }} on {{ $site.Title }}
      {{- end -}}
    </description>

    <generator>Hugo</generator>

    {{ with $site.LanguageCode }}
    <language>{{ . }}</language>
    {{ end }}

    {{ with $site.Params.copyright }}
    <copyright>{{ . }}</copyright>
    {{ end }}

    {{ with $page.Date }}
    {{ if not .IsZero }}
    <lastBuildDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{ end }}
    {{ end }}

    {{ with $page.OutputFormats.Get "RSS" }}
      <atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType }}" />
    {{ end }}

    {{ range $page.Pages }}
      {{- if ne .Params.feed_exclude true -}}
      <item>
        <title>{{ .Title }}</title>
        <link>{{ .Permalink }}</link>
        <guid isPermaLink="true">{{ .Permalink }}</guid>

        {{ with .Date }}
        <pubDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        {{ end }}

        {{ with .Params.author }}
        <author>{{ . }}</author>
        {{ end }}

        <description>{{ .Summary | html }}</description>
      </item>
      {{- end -}}
    {{ end }}

  </channel>
</rss>